flowchart LR
  USER@{ shape: person, label: "External<br>Participant"}
  WEBEX@{ shape: cloud, label: "Webex Services"}

  subgraph SERVICE ["Webex Connect Service"]
    direction TB

    subgraph SESSIONG [" "]
      direction LR
      SESSION["Session Flow<br/>( Pre-Configured Timeout )"]
      END(["End Session"])
      SESSION -- "Timeout" --> END
    end

    subgraph WXG ["Webex"]
      WXIN["Inbound Webex Flow"]
    end

    subgraph SMSMMS ["SMS / MMS"]
      direction BT
      MMS["Inbound MMS Flow"]
      SMS["Inbound SMS Flow"]
      MMS -- "attached files" --> SMS
    end

    SESSIONG -- "Start / Extend" --- WXG
    SESSIONG -- "Start / Extend" --- SMSMMS
    WXG -- "End Session<br>( card button )" --> SESSIONG
  end

  USER -- "SMS / MMS" --> SERVICE
  %% Plain line here; the build script adds the arrowhead on the SERVICE end (see @arrow-start below)
  SERVICE -- "Webhooks<br>[messages]<br>[attachementActions]" --- WEBEX
